# Nunca coloque valores reais neste arquivo.
# Copie para .env.local e preencha somente no ambiente local/Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Identificador único da loja, igual ao slug cadastrado em companies.
COMPANY_SLUG=loja-exemplo
SITE_NAME=Nome da Loja
SITE_DESCRIPTION=Confira os produtos da nossa loja.

# Supabase: usadas exclusivamente no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Endereço público do site, usado em metadados.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
